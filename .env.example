# Copy to .env. Never commit the real .env.

LITELLM_MASTER_KEY=sk-change-me-with-openssl-rand
LITELLM_SALT_KEY=sk-change-me-and-keep-stable
GATEWAY_PORT=8080
LAB_LLM_SITE=:8080

POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=change-me

ARENA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=

# Starting candidate for a single 24 GB GPU. Validate before standardizing.
LOCAL_CODE_MODEL=dark-side-of-the-code/Qwen3-Coder-30B-A3B-Instruct-AWQ
LOCAL_MAX_MODEL_LEN=32768
VLLM_GPU_MEMORY_UTILIZATION=0.90

# Pin exact known-good versions after first validation.
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:latest
VLLM_IMAGE=vllm/vllm-openai:latest
